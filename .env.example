# Configuración local. Copiar a .env y generar una clave propia.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Vacío utiliza SQLite para demostración monousuario.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Opcional: solo para crear usuarios de demo. Si se omite, se generan claves aleatorias.
DEMO_PASSWORD=
# Consulta externa de RUC: token del plan gratuito de https://consultaderuc.pe
# Solo backend; no habilita emision real a SUNAT.
RUC_API_TOKEN=
# Consulta DNI mediante Factiliza (proveedor independiente, plan gratuito).
DNI_API_TOKEN=
